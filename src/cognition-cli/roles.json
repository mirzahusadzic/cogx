{
  "description": "Architectural Role Classification Configuration for Cognition Σ. This file maps the codebase into its dual-lattice architecture (Conversation O1-O7 & Project PGC) to enable high-fidelity structural reasoning and pattern analysis.",
  "roles": [
    {
      "id": "data_persistence",
      "priority": 120,
      "rules": [
        { "path": ".*/db/.*" },
        { "path": ".*/repositories/.*" },
        { "name": ".*(Store|Repository|DAO|Database|Persistence)$" }
      ],
      "description": "Persistence layers, vector databases (LanceDB), and data access objects."
    },
    {
      "id": "error_handling",
      "priority": 118,
      "rules": [{ "name": ".*Error$" }, { "path": ".*/errors/.*" }],
      "description": "Exception types, error classes, and error handling logic."
    },
    {
      "id": "intelligence_mining",
      "priority": 115,
      "rules": [
        { "path": ".*/core/analyzers/.*" },
        { "path": ".*/core/parsers/.*" },
        { "path": ".*/core/orchestrators/miners/.*" },
        { "path": ".*/core/executors/.*" },
        { "name": ".*(Extractor|Classifier|Miner|Analyzer|Parser)$" }
      ],
      "description": "Intelligence engines, structural miners, and semantic extractors responsible for knowledge derivation."
    },
    {
      "id": "state_management",
      "priority": 112,
      "rules": [
        { "path": ".*/core/state/.*" },
        {
          "name": ".*(StateMachine|Registry|SessionManager|TUISyncManager|BackgroundTaskManager)$"
        }
      ],
      "description": "System state machines, session persistence, and cross-component synchronization logic."
    },
    {
      "id": "lattice_conversation",
      "priority": 110,
      "rules": [
        { "path": ".*/sigma/.*" },
        { "name": ".*(Compressor|Reconstructor|Lattice|Context|Overlay).*" }
      ],
      "description": "Conversation Lattice (O1-O7) components responsible for semantic context management, compression, and reconstruction."
    },
    {
      "id": "lattice_project",
      "priority": 105,
      "rules": [
        { "path": ".*/core/pgc/.*" },
        { "path": ".*/core/overlays/.*" },
        { "path": ".*/core/orchestrators/.*" },
        { "path": ".*/core/quest/.*" },
        { "path": ".*/core/query/.*" },
        { "path": ".*/core/transforms/.*" },
        { "name": ".*(PGC|Manifest|Pattern|Orchestrator|Oracle).*" }
      ],
      "description": "Project Lattice (PGC) components managing the Grounded Context Pool, structural patterns, and lineage overlays."
    },
    {
      "id": "bus_coordination",
      "priority": 100,
      "rules": [
        { "path": ".*/ipc/.*" },
        { "name": ".*(Bus|Coordinator|Publisher|Subscriber|ZMQ).*" }
      ],
      "description": "ZeroMQ-based IPC bus for cross-process coordination between the TUI, agents, and the context engine."
    },
    {
      "id": "logic_algebra",
      "priority": 95,
      "rules": [
        { "path": ".*/core/algebra/.*" },
        { "path": ".*/core/graph/.*" },
        { "name": ".*(Algebra|Graph|Lattice).*" }
      ],
      "description": "Mathematical foundations for lattice operations, graph theory, and semantic merging."
    },
    {
      "id": "provider_llm",
      "priority": 90,
      "rules": [
        { "path": ".*/llm/.*" },
        { "name": ".*(LLM|Provider|Adapter|Agent).*" }
      ],
      "description": "LLM abstraction layer and provider implementations (Gemini, Claude, OpenAI)."
    },
    {
      "id": "tui_commands",
      "priority": 86,
      "rules": [{ "path": ".*/tui/commands/.*" }],
      "description": "TUI-specific slash commands and loader logic."
    },
    {
      "id": "tui_interface",
      "priority": 85,
      "rules": [
        { "path": ".*/tui/.*" },
        { "path": ".*/components/.*" },
        { "path": ".*/views/.*" },
        { "name": ".*(View|Component|Widget|Screen|Props)$" }
      ],
      "description": "React/Ink-based terminal user interface and visual workspace components."
    },
    {
      "id": "cli_commands",
      "priority": 80,
      "rules": [
        { "path": ".*/commands/.*" },
        { "path": ".*/cli\\.ts$" },
        { "name": ".*Command$" }
      ],
      "description": "CLI command definitions and entry points for the cognition-cli."
    },
    {
      "id": "configuration",
      "priority": 75,
      "rules": [
        { "path": ".*/config/.*" },
        { "path": ".*/config\\.ts$" },
        { "name": ".*(Config|Options)$" }
      ],
      "description": "System configuration, environment settings, and runtime options."
    },
    {
      "id": "service_core",
      "priority": 70,
      "rules": [
        { "path": ".*/services/.*" },
        { "path": ".*/core/watcher/.*" },
        { "name": ".*(Service|Manager|Registry|Monitor).*" }
      ],
      "description": "General-purpose core services and system managers."
    },
    {
      "id": "security_integrity",
      "priority": 65,
      "rules": [
        { "path": ".*/security/.*" },
        { "name": ".*(Security|Integrity|Validator|Audit).*" }
      ],
      "description": "Security monitors, codebase integrity validators, and audit tools."
    },
    {
      "id": "utility_support",
      "priority": 50,
      "rules": [
        { "path": ".*/utils/.*" },
        { "path": ".*/helpers/.*" },
        { "name": ".*(Util|Helper|Support).*" }
      ],
      "description": "Shared utility functions, formatting helpers, and support logic."
    },
    {
      "id": "type_definition",
      "priority": 40,
      "rules": [
        { "path": ".*/types/.*" },
        { "path": ".*/interfaces/.*" },
        { "name": ".*(Type|DTO|Interface|Enum)$" }
      ],
      "description": "TypeScript type definitions, interfaces, and domain models."
    },
    {
      "id": "logic_component",
      "priority": 0,
      "rules": [],
      "description": "General logic components, glue code, or uniquely specialized modules."
    }
  ],
  "defaultRole": "logic_component"
}
